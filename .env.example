# App Environment
APP_ENV=production

# Database Configuration
DB_HOST=
DB_NAME=botcanchero
DB_USER=
DB_PASS=

# App Configuration
WEBSITE_URL=https://botcanchero.com
COMPANY_NAME=BotCanchero
BASE_URL=https://saas.botcanchero.com/

# Mercado Pago OAuth (owner account linking)
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=
# Optional. If empty, app auto-detects callback URL from current host.
# Example local: http://localhost:8080/app/mercadopago_OAuth
# Example prod: https://saas.botcanchero.com/mercadopago_OAuth
MP_OAUTH_REDIRECT_URI=

# Resend Email (password reset)
RESEND_API_KEY=
# In development can be onboarding@resend.dev. In production use verified domain sender.
RESEND_FROM=
